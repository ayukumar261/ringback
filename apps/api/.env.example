PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/ringback

# Audio
# AUDIO_DIR=/absolute/path/to/recordings

# LiveKit
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Twilio Lookup v2 (Account SID/Auth Token; server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RINGBACK_LOOKUP_TIMEOUT_MS=5000
RINGBACK_LOOKUP_CACHE_TTL_SECONDS=3600

# Destination policy. Territories and shared NANP toll-free are explicit opt-ins.
RINGBACK_ALLOWED_COUNTRIES=US
RINGBACK_ALLOWED_US_TERRITORIES=
RINGBACK_ALLOWED_LINE_TYPES=landline,mobile,fixedVoip,nonFixedVoip
RINGBACK_ALLOW_NANP_TOLL_FREE=false
# Comma-separated E.164 prefixes to block in addition to built-in number rules.
RINGBACK_BLOCKED_PHONE_PREFIXES=

# Stripe
# Note: development uses the Sandbox keys and production uses the live keys
STRIPE_SANDBOX_API_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_PRODUCTION_API_KEY=
STRIPE_PRODUCTION_WEBHOOK_SECRET=

# Ringback
RINGBACK_CALLS_KEEPALIVE_MS=15000
RINGBACK_CALLS_RETRY_MS=3000
RINGBACK_CALL_PRICE_CENTS=50
RINGBACK_CALL_CURRENCY=usd
# Stripe Managed Payments: AIaaS, cloud-based, personal use; choose an eligible tax code for your product.
RINGBACK_PRODUCT_TAX_CODE=txcd_10105001
RINGBACK_PUBLIC_API_URL=http://localhost:3001
RINGBACK_PUBLIC_WEB_URL=http://localhost:3000
